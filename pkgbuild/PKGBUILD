pkgname=mbingjustread-md
pkgver=0.1.0
pkgrel=1
pkgdesc='A fast, accurate reader for Markdown files. It only reads.'
arch=('x86_64' 'aarch64')
url='https://github.com/navis23/mbingjustread-md'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'md4c' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/mbingjustread-md "$pkgdir/usr/bin/mbingjustread-md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 "$startdir/mbingjustread-md.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/mbingjustread-md.svg"
  install -Dm644 "$startdir/mbingjustread-md.desktop" "$pkgdir/usr/share/applications/mbingjustread-md.desktop"
}
